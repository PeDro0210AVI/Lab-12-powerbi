table PredSerie
	column id_pred_serie
		dataType: int64
		summarizeBy: none
		sourceColumn: id_pred_serie

	column alcance
		dataType: string
		summarizeBy: none
		sourceColumn: alcance

	column modelo
		dataType: string
		summarizeBy: none
		sourceColumn: modelo

	column fecha
		dataType: dateTime
		formatString: yyyy-mm
		summarizeBy: none
		sourceColumn: fecha

	column conjunto
		dataType: string
		summarizeBy: none
		sourceColumn: conjunto

	column real
		dataType: double
		summarizeBy: none
		sourceColumn: real

	column estimado
		dataType: double
		summarizeBy: none
		sourceColumn: estimado

	column error
		dataType: double
		summarizeBy: none
		sourceColumn: error

	column inferior
		dataType: double
		summarizeBy: none
		sourceColumn: inferior

	column superior
		dataType: double
		summarizeBy: none
		sourceColumn: superior

	partition PredSerie = m
		mode: import
		source =
				let
				    Fuente = Csv.Document(File.Contents(RutaDatos & "\modelos\predicciones_serie.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"id_pred_serie", Int64.Type}, {"alcance", type text}, {"modelo", type text}, {"fecha", type date}, {"conjunto", type text}, {"real", type number}, {"estimado", type number}, {"error", type number}, {"inferior", type number}, {"superior", type number}}, "en-US")
				in
				    Tipos
