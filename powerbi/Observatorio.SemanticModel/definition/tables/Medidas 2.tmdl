table Medidas
	measure Visitantes = SUM(Mensual[llegadas])
		formatString: #,0

	measure 'Derrama USD' = SUM(Mensual[gasto_total_usd])
		formatString: "US$" #,0

	measure 'Visitantes periodo anterior' = ```
			VAR i = MIN(Calendario[Anio]) VAR f = MAX(Calendario[Anio]) VAR n = f - i + 1
			RETURN CALCULATE([Visitantes], REMOVEFILTERS(Calendario), Calendario[Anio] >= i - n, Calendario[Anio] <= i - 1)
			```
		formatString: #,0

	measure 'Derrama periodo anterior' = ```
			VAR i = MIN(Calendario[Anio]) VAR f = MAX(Calendario[Anio]) VAR n = f - i + 1
			RETURN CALCULATE([Derrama USD], REMOVEFILTERS(Calendario), Calendario[Anio] >= i - n, Calendario[Anio] <= i - 1)
			```
		formatString: "US$" #,0

	measure 'Variacion visitantes' = DIVIDE([Visitantes], [Visitantes periodo anterior]) - 1
		formatString: 0.0%

	measure 'Variacion derrama' = DIVIDE([Derrama USD], [Derrama periodo anterior]) - 1
		formatString: 0.0%

	measure 'Estancia promedio' = DIVIDE(SUMX(Mensual, Mensual[estancia_promedio] * Mensual[llegadas]), [Visitantes])
		formatString: 0.00

	measure 'Satisfaccion ponderada' = DIVIDE(SUMX(Mensual, Mensual[satisfaccion_promedio] * Mensual[llegadas]), [Visitantes])
		formatString: 0.00

	measure 'Gasto por visitante' = DIVIDE([Derrama USD], [Visitantes])
		formatString: "US$" #,0

	measure 'Satisfaccion media' = AVERAGE(Mensual[satisfaccion_promedio])
		formatString: 0.00

	measure Ocupacion = AVERAGE(Mensual[ocupacion_hotelera])
		formatString: 0.0

	measure 'Gasto diario' = AVERAGE(Mensual[gasto_diario_usd])
		formatString: "US$" #,0

	measure 'Presion turistica' = AVERAGE(Mensual[presion_turistica])
		formatString: 0.00

	measure 'Estado de presion' = IF(ISBLANK([Presion turistica]), BLANK(), SWITCH(TRUE(), [Presion turistica] >= 1, "Saturacion", [Presion turistica] >= 0.85, "Al limite", "Holgura"))

	measure 'Color de presion' = SWITCH(TRUE(), [Presion turistica] >= 1, "#F72585", [Presion turistica] >= 0.85, "#FFA630", "#60A125")

	measure 'CO2 toneladas' = SUM(Mensual[co2_ton])
		formatString: #,0

	measure 'Empleo local' = AVERAGE(Mensual[empleo_local_pct])
		formatString: 0.0

	measure 'Empresas certificadas' = AVERAGE(Mensual[empresas_certificadas_pct])
		formatString: 0.0

	measure 'Holgura de carga' = 100 * (1 - MIN(MAX([Presion turistica], 0), 1.4) / 1.4)
		formatString: 0

	measure 'Satisfaccion 0-100' = ([Satisfaccion media] - 1) / 4 * 100
		formatString: 0

	measure 'CO2 por noche' = DIVIDE(SUM(Mensual[co2_ton]), SUM(Mensual[noches_totales])) * 1000
		formatString: 0.0

	measure 'Residuos por noche' = DIVIDE(SUM(Mensual[residuos_ton]), SUM(Mensual[noches_totales])) * 1000
		formatString: 0.0

	measure 'Eficiencia en CO2' = 100 * (1 - DIVIDE([CO2 por noche], MAXX(ALLSELECTED(Destinos[destino]), [CO2 por noche])))
		formatString: 0

	measure 'Eficiencia en residuos' = 100 * (1 - DIVIDE([Residuos por noche], MAXX(ALLSELECTED(Destinos[destino]), [Residuos por noche])))
		formatString: 0

	measure 'Llegadas por mercado' = SUM(LlegadasMercado[llegadas])
		formatString: #,0

	measure 'Participacion de mercado' = DIVIDE([Llegadas por mercado], CALCULATE([Llegadas por mercado], ALLSELECTED(Mercados)))
		formatString: 0.0%

	measure 'Derrama por categoria' = SUM(GastoCategoria[gasto_usd])
		formatString: "US$" #,0

	measure Encuestas = COUNTROWS(Visitantes)
		formatString: #,0

	measure 'Gasto mediano' = MEDIAN(Visitantes[gasto_total_usd])
		formatString: "US$" #,0

	measure 'Gasto P25' = PERCENTILE.INC(Visitantes[gasto_total_usd], 0.25)
		formatString: "US$" #,0

	measure 'Gasto P75' = PERCENTILE.INC(Visitantes[gasto_total_usd], 0.75)
		formatString: "US$" #,0

	measure 'Observado prueba' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			VAR m = SELECTEDVALUE(ModeloSerie[modelo], "Suavizamiento (Holt-Winters)")
			RETURN CALCULATE(AVERAGE(PredSerie[real]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = m, PredSerie[conjunto] = "Prueba (ultimos 12 meses)")
			```
		formatString: #,0

	measure 'Estimado futuro' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			VAR m = SELECTEDVALUE(ModeloSerie[modelo], "Suavizamiento (Holt-Winters)")
			RETURN CALCULATE(AVERAGE(PredSerie[estimado]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = m, PredSerie[conjunto] = "Pronostico (12 meses futuros)")
			```
		formatString: #,0

	measure 'Limite inferior' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			VAR m = SELECTEDVALUE(ModeloSerie[modelo], "Suavizamiento (Holt-Winters)")
			RETURN CALCULATE(AVERAGE(PredSerie[inferior]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = m, PredSerie[conjunto] = "Pronostico (12 meses futuros)")
			```
		formatString: #,0

	measure 'Limite superior' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			VAR m = SELECTEDVALUE(ModeloSerie[modelo], "Suavizamiento (Holt-Winters)")
			RETURN CALCULATE(AVERAGE(PredSerie[superior]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = m, PredSerie[conjunto] = "Pronostico (12 meses futuros)")
			```
		formatString: #,0

	measure 'Tendencia + estacionalidad (prueba)' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(PredSerie[estimado]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = "Tendencia + estacionalidad", PredSerie[conjunto] = "Prueba (ultimos 12 meses)")
			```
		formatString: #,0

	measure 'Holt-Winters (prueba)' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(PredSerie[estimado]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = "Suavizamiento (Holt-Winters)", PredSerie[conjunto] = "Prueba (ultimos 12 meses)")
			```
		formatString: #,0

	measure 'SARIMA (prueba)' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(PredSerie[estimado]), REMOVEFILTERS(ModeloSerie), PredSerie[alcance] = a, PredSerie[modelo] = "SARIMA", PredSerie[conjunto] = "Prueba (ultimos 12 meses)")
			```
		formatString: #,0

	measure 'Error absoluto medio' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(MetricasSerie[valor]), MetricasSerie[alcance] = a, MetricasSerie[metrica] = "MAE")
			```
		formatString: #,0

	measure RMSE = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(MetricasSerie[valor]), MetricasSerie[alcance] = a, MetricasSerie[metrica] = "RMSE")
			```
		formatString: #,0

	measure 'Error porcentual (MAPE)' = ```
			VAR a = SELECTEDVALUE(Alcance[alcance], "Todos los destinos")
			RETURN CALCULATE(AVERAGE(MetricasSerie[valor]), MetricasSerie[alcance] = a, MetricasSerie[metrica] = "MAPE")
			```
		formatString: 0.00

	measure 'Casos evaluados' = COUNTROWS(PredClase)
		formatString: #,0

	measure 'Probabilidad media' = AVERAGE(PredClase[prob_promotor])
		formatString: 0.0%

	measure 'Valor de metrica' = AVERAGE(MetricasClase[valor])
		formatString: 0.000

	measure 'Tasa de aciertos' = AVERAGE(CurvaROC[tasa_aciertos])
		formatString: 0.00

	measure 'AUC validacion' = AVERAGE(CurvaAprendizaje[validacion])
		formatString: 0.000

	measure 'Peso del factor' = ```
			VAR m = SELECTEDVALUE(ModeloClase[modelo], "Regresion logistica")
			RETURN CALCULATE(SUM(Importancia[peso]), REMOVEFILTERS(ModeloClase), Importancia[modelo] = m)
			```
		formatString: 0.000

	measure 'Seleccion activa' = ```
			VAR i = MIN(Calendario[Anio]) VAR f = MAX(Calendario[Anio])
			VAR d = IF(ISFILTERED(Destinos[destino]) || ISFILTERED(Destinos[region]), CONCATENATEX(VALUES(Destinos[destino]), Destinos[destino], ", "), "Todos los destinos")
			RETURN "Viendo: " & i & "-" & f & " | " & d
			```

	measure 'Mensaje sin datos' = IF(ISBLANK([Visitantes]) && ISBLANK([Encuestas]), "No hay datos para esta seleccion. Amplie el periodo o pulse Restablecer.", " ")

	column Auxiliar
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Auxiliar

	partition Medidas = m
		mode: import
		source =
				let
				    Final = #table(type table [Auxiliar = Int64.Type], {{1}})
				in
				    Final
