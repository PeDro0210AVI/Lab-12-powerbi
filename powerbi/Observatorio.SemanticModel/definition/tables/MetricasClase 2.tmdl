table MetricasClase
	column modelo
		dataType: string
		summarizeBy: none
		sourceColumn: modelo

	column metrica
		dataType: string
		summarizeBy: none
		sourceColumn: metrica

	column valor
		dataType: double
		summarizeBy: none
		sourceColumn: valor

	column conjunto_evaluacion
		dataType: string
		summarizeBy: none
		sourceColumn: conjunto_evaluacion

	partition MetricasClase = m
		mode: import
		source =
				let
				    Fuente = Csv.Document(File.Contents(RutaDatos & "\modelos\metricas_clasificacion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"modelo", type text}, {"metrica", type text}, {"valor", type number}, {"conjunto_evaluacion", type text}}, "en-US")
				in
				    Tipos
