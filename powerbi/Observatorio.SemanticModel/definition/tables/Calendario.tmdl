table Calendario
	column Fecha
		dataType: dateTime
		formatString: yyyy-mm
		summarizeBy: none
		sourceColumn: Fecha

	column Anio
		dataType: int64
		summarizeBy: none
		sourceColumn: Anio

	column Trimestre
		dataType: string
		summarizeBy: none
		sourceColumn: Trimestre

	column MesNum
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MesNum

	column Mes
		dataType: string
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: MesNum

	hierarchy 'Periodo'
		level Anio
			column: Anio
		level Trimestre
			column: Trimestre
		level Mes
			column: Mes

	partition Calendario = m
		mode: import
		source =
				let
				    Fechas = List.Generate(() => #date(2017, 1, 1), each _ <= #date(2026, 12, 1), each Date.AddMonths(_, 1)),
				    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), type table [Fecha = date]),
				    Anio = Table.AddColumn(Tabla, "Anio", each Date.Year([Fecha]), Int64.Type),
				    Trim = Table.AddColumn(Anio, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([Fecha])), type text),
				    Num = Table.AddColumn(Trim, "MesNum", each Date.Month([Fecha]), Int64.Type),
				    Nombres = #table(type table [MesNum = Int64.Type, Mes = text], {{1, "Ene"}, {2, "Feb"}, {3, "Mar"}, {4, "Abr"}, {5, "May"}, {6, "Jun"}, {7, "Jul"}, {8, "Ago"}, {9, "Sep"}, {10, "Oct"}, {11, "Nov"}, {12, "Dic"}}),
				    Final = Table.ExpandTableColumn(Table.NestedJoin(Num, "MesNum", Nombres, "MesNum", "n", JoinKind.Inner), "n", {"Mes"})
				in
				    Final
